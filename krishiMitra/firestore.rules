rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read and write their own data
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isOwner(userId);
    }
    
    // Farms collection
    match /farms/{farmId} {
      // Anyone can read farms (for discovery/mapping)
      allow read: if true;
      // Only authenticated users can create farms
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only farm owner can update/delete
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Crops collection
    match /crops/{cropId} {
      // Public read access for all crop data
      allow read: if true;
      // Only authenticated users can create crops
      allow create: if isSignedIn();
      // Only authenticated users can update/delete (for admin features)
      allow update, delete: if isSignedIn();
    }
    
    // Plantings collection
    match /plantings/{plantingId} {
      // Users can read all plantings (for community insights)
      allow read: if true;
      // Only authenticated users can create plantings
      allow create: if isSignedIn();
      // Only owner can update/delete their plantings
      allow update, delete: if isSignedIn() && 
        get(/databases/$(database)/documents/farms/$(resource.data.farmId)).data.userId == request.auth.uid;
    }
    
    // Pests collection
    match /pests/{pestId} {
      // Public read access for pest information
      allow read: if true;
      // Only authenticated users can add pest data
      allow create: if isSignedIn();
      // Only authenticated users can update/delete
      allow update, delete: if isSignedIn();
    }
    
    // Pest Reports collection
    match /pestReports/{reportId} {
      // Users can read all pest reports (for community awareness)
      allow read: if true;
      // Only authenticated users can create reports
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only report creator can update/delete
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    // Chat History collection
    match /chatHistory/{chatId} {
      // Users can only read their own chat history
      allow read: if isOwner(resource.data.userId);
      // Only authenticated users can create chat history
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Users can update their own chats (for feedback)
      allow update: if isOwner(resource.data.userId);
      // Users can delete their own chat history
      allow delete: if isOwner(resource.data.userId);
    }
    
    // User Activity collection
    match /userActivity/{activityId} {
      // Users can only read their own activity
      allow read: if isOwner(resource.data.userId);
      // Only authenticated users can create activity logs
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // No updates or deletes (activity log is immutable)
      allow update, delete: if false;
    }
    
    // Farm Data collection
    match /farmData/{dataId} {
      // Users can read their own farm data
      allow read: if isOwner(resource.data.userId);
      // Only authenticated users can create farm data
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only owner can update/delete
      allow update, delete: if isOwner(resource.data.userId);
    }
  }
}
